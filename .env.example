# Postgres local (Docker)
DATABASE_URL=postgresql://crm:crm@postgres:5432/crm?sslmode=disable
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm

# MinIO local (adjuntos)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=attachments
MINIO_USE_SSL=false

# Zernio API
ZERNIO_API_KEY=sk_...
ZERNIO_WEBHOOK_SECRET=

# OpenRouter (agente IA)
OPENROUTER_API_KEY=

# Server
PORT=8080
AUTH_JWT_SECRET=change-me-secret

# Temporal (solo dump/restore inicial desde Supabase, borrar luego)
SUPABASE_LEGACY_DB_URL=postgresql://...@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# ---------------------------------------------------------------------
# IA LOCAL (Fase 19/20). Corre en docker-compose, en esta maquina.
# Ningun texto de cliente sale del equipo.
# ---------------------------------------------------------------------

# Interruptor maestro por ENV. El de la DB (app_settings) gana despues:
# se puede apagar desde la UI sin tocar el contenedor.
INSIGHT_ENABLED=true

# Ollama. granite3.3:2b es el ganador del bench (80% de acierto, 0.47s p50,
# 1.55 GB). Ver scripts/bench_llm.py para repetirlo.
#   ollama pull granite3.3:2b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=granite3.3:2b
OLLAMA_TIMEOUT=90s

# Un solo worker de texto: cada request satura la CPU con un modelo de 2B.
INSIGHT_TEXT_WORKERS=1

# Whisper para notas de voz (Fase 20). Servicio whisper en compose.
#   modelos: tiny | base | small | medium | large-v3
WHISPER_MODEL=small
ASR_BASE_URL=http://whisper:9000
ASR_TIMEOUT=120s
ASR_DOWNLOAD_TIMEOUT=60s

# Logs estructurados. LOG_FORMAT=human para leerlos crudo en una terminal.
LOG_LEVEL=info
LOG_FORMAT=json
